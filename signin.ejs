<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In — HelpWithTutor</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
  <div class="container">
    <div id="auth-error" class="error-msg" style="display:none;"></div>
    <form id="signin-form" class="signup_form">
      <div class="form_header">
        <h1>Sign in</h1>
        <p>Don't have an account? <a href="/signup">Sign up</a></p>
      </div>
      <label for="email">Email</label>
      <input id="email" type="email" name="email" class="auth-input" required placeholder="you@example.com">
      <label for="password">Password</label>
      <input id="password" type="password" name="password" class="auth-input" required placeholder="Enter your password">
      <input type="submit" value="Sign in" id="submit-btn">
    </form>
  </div>
  <script src="/js/auth.js"></script>
  <script>
    document.getElementById('signin-form').addEventListener('submit', handleSignIn);
  </script>
</body>
</html>
