<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>History — HelpWithTutor</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Oswald:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="stylesheet" href="/css/dashboard.css" />
</head>
<body class="bg-[#050505] text-white font-[Inter] min-h-screen">

  <nav class="fixed top-0 left-0 right-0 z-50 bg-[#050505]/90 backdrop-blur-md border-b border-white/5">
    <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/dashboard" class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-[#E30613] flex items-center justify-center">
          <i data-lucide="graduation-cap" class="w-4 h-4 text-white"></i>
        </div>
        <span class="font-[Oswald] text-lg font-medium tracking-wide hidden sm:inline">HELP<span class="text-[#E30613]">WITH</span>TUTOR</span>
      </a>
      <div class="flex items-center gap-4">
        <a href="/history" class="flex items-center gap-2 text-sm text-[#E30613] transition-colors">
          <i data-lucide="clock" class="w-4 h-4"></i>
          <span class="hidden sm:inline">History</span>
        </a>
        <div id="user-menu" class="relative">
          <button id="user-btn" class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-white/10 hover:border-white/20 transition-colors">
            <div class="w-6 h-6 rounded-full bg-[#E30613] flex items-center justify-center text-xs font-medium" id="user-avatar">U</div>
            <span class="text-sm text-gray-300 hidden sm:inline" id="user-name">User</span>
            <i data-lucide="chevron-down" class="w-3 h-3 text-gray-500"></i>
          </button>
          <div id="user-dropdown" class="hidden absolute right-0 top-full mt-2 w-48 bg-[#111] border border-white/10 rounded-lg shadow-2xl overflow-hidden">
            <div class="px-4 py-3 border-b border-white/5">
              <p class="text-sm font-medium" id="dropdown-name">User</p>
              <p class="text-xs text-gray-500" id="dropdown-email">user@email.com</p>
            </div>
            <a href="/dashboard" class="w-full text-left px-4 py-2.5 text-sm text-gray-400 hover:bg-white/5 hover:text-white transition-colors flex items-center gap-2 block">
              <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
              Dashboard
            </a>
            <button onclick="handleLogout()" class="w-full text-left px-4 py-2.5 text-sm text-gray-400 hover:bg-white/5 hover:text-[#E30613] transition-colors flex items-center gap-2">
              <i data-lucide="log-out" class="w-4 h-4"></i>
              Sign Out
            </button>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <main class="pt-24 pb-16 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 class="font-[Oswald] text-3xl md:text-4xl font-medium tracking-tight">History</h1>
          <p class="text-gray-400 font-light mt-2">Your previously generated plans, quizzes, and explanations.</p>
        </div>
        <a href="/dashboard" class="flex items-center gap-2 px-4 py-2 bg-[#E30613] hover:bg-[#b91c1c] text-white text-sm font-medium rounded-lg transition-colors">
          <i data-lucide="plus" class="w-4 h-4"></i>
          <span class="hidden sm:inline">New</span>
        </a>
      </div>

      <!-- Filters -->
      <div class="flex items-center gap-2 mb-6">
        <button data-filter="all" class="filter-btn active-filter px-4 py-2 rounded-lg border border-white/10 text-sm text-gray-500 transition-all duration-300 hover:border-[#E30613]/50">All</button>
        <button data-filter="plan" class="filter-btn px-4 py-2 rounded-lg border border-white/10 text-sm text-gray-500 transition-all duration-300 hover:border-[#E30613]/50">Plans</button>
        <button data-filter="quiz" class="filter-btn px-4 py-2 rounded-lg border border-white/10 text-sm text-gray-500 transition-all duration-300 hover:border-[#E30613]/50">Quizzes</button>
        <button data-filter="explanation" class="filter-btn px-4 py-2 rounded-lg border border-white/10 text-sm text-gray-500 transition-all duration-300 hover:border-[#E30613]/50">Explanations</button>
      </div>

      <div id="plans-list" class="space-y-3"></div>

      <div id="empty-state" class="hidden text-center py-20">
        <i data-lucide="inbox" class="w-12 h-12 text-gray-700 mx-auto mb-4"></i>
        <p class="text-gray-500 text-sm">No plans found.</p>
        <a href="/dashboard" class="inline-flex items-center gap-2 mt-4 text-sm text-[#E30613] hover:underline">
          Generate your first plan
          <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </a>
      </div>
    </div>
  </main>

  <div id="plan-modal" class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" onclick="closeModal()"></div>
    <div class="relative bg-[#0a0a0a] border border-white/10 rounded-2xl w-full max-w-2xl max-h-[85vh] overflow-hidden flex flex-col">
      <div class="flex items-center justify-between px-6 py-4 border-b border-white/5 shrink-0">
        <h2 class="font-[Oswald] text-lg font-medium" id="modal-title">Plan Details</h2>
        <button onclick="closeModal()" class="p-1.5 rounded-lg hover:bg-white/5 text-gray-400 hover:text-white transition-colors">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>
      <div id="modal-content" class="flex-1 overflow-y-auto p-6 space-y-4"></div>
    </div>
  </div>

  <div id="toast-container" class="fixed bottom-6 right-6 z-[100] space-y-3"></div>

  <script src="/js/history.js"></script>
</body>
</html>